    <string name="feature_settings_folders_intro">NextGallery only shows the folders you add here, with their subfolders. Removing a folder only hides it in NextGallery. No file is touched.</string>
    <string name="feature_settings_folders_none">No folders added.</string>
    <string name="feature_settings_folder_add">Add folder</string>
    <string name="feature_settings_folder_add_failed">This folder can\'t be added. Choose a folder on the phone\'s storage or on an SD card, not the top level of the storage.</string>
    <string name="feature_settings_folder_remove">Remove</string>
    <string name="feature_settings_folder_remove_description">Remove %1$s</string>
    <string name="feature_settings_folder_on_volume">%1$s · %2$s</string>
    <string name="feature_settings_folders_note">Android\'s folder picker doesn\'t offer every folder, such as the top level of the storage or the Download folder itself. Inside an added folder, Android hides folders with a .nomedia file, and NextGallery hides folders whose name starts with a dot.</string>
    <string name="feature_settings_virtual_folders">Virtual folders</string>
    <string name="feature_settings_virtual_folders_intro">A virtual folder shows the photos of several folders together, for example Camera, WhatsApp and Signal. It appears in the folder list once it has photos.</string>
    <string name="feature_settings_virtual_folders_needs_folder">Virtual folders combine folders that have photos, so you need one of those first.</string>
